<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
    P16 G10: OWASP dependency-check 已知误报豁免
    每条豁免必须包含: CVE编号、豁免原因、审批人、有效期
  -->

  <!-- Spring Boot Starter 内嵌 Tomcat — 仅在开发模式使用，生产环境使用外部容器 -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-core@.*$</packageUrl>
    <cve>CVE-2024-34759</cve>
    <cve>CVE-2025-24813</cve>
  </suppress>

  <!-- Jackson Databind — Spring Boot BOM 管理版本，已通过 Spring Security 公告确认安全 -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson-databind@.*$</packageUrl>
    <cve>CVE-2024-54679</cve>
  </suppress>

  <!-- Apache Jena — 本体存储引擎，无外部网络暴露 -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.jena/.*@.*$</packageUrl>
    <vulnerabilityName>HTTP Request Smuggling</vulnerabilityName>
  </suppress>

  <!--
    CVE-2026-0994 假阳性抑制（CLASSIFICATION=FALSE_POSITIVE_CONFIRMED）
    AFFECTED_ECOSYSTEM=Python（google.protobuf.json_format.ParseDict() DoS，修复于 6.33.5）
    SCANNED_COMPONENT=Java com.google.protobuf:protobuf-java
    SUPPRESSION_SCOPE=CVE-2026-0994 only（精确绑定，无宽泛正则）
    REVIEW_REQUIRED=YES
    CREATED_AT=2026-08-18
    OWNER_DECISION=APPROVE_P20_CASCADE_SECURITY_REMEDIATION_LIMITED
    AUTHORITY=NVD / Google protobuf advisory（CVE 位于 Python 实现 json_format.ParseDict()，
    不影响 Java protobuf-java）
  -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/com\.google\.protobuf/protobuf-java@.*$</packageUrl>
    <cve>CVE-2026-0994</cve>
  </suppress>

  <!--
    Log4j 组件不匹配抑制（CLASSIFICATION=SCANNER_COMPONENT_MISMATCH）
    以下 CVE 均位于 org.apache.logging.log4j:log4j-core（如 Rfc5424Layout 等布局/appender）。
    本项目仅使用 log4j-to-slf4j + log4j-api（SLF4J 桥），无 log4j-core，无 log4j2 配置文件，
    不引用任何受影响布局/appender；log4j-core 不存在，故这些 CVE 在本项目不可利用。
    SUPPRESSION_SCOPE=log4j-api only，精确绑定下列 CVE，无宽泛正则
    REVIEW_REQUIRED=YES
    CREATED_AT=2026-08-18
    OWNER_DECISION=APPROVE_P20_CASCADE_SECURITY_REMEDIATION_LIMITED
    AUTHORITY=NVD（CVE-2026-34478 等位于 log4j-core Rfc5424Layout）
  -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
    <cve>CVE-2026-34477</cve>
    <cve>CVE-2026-34478</cve>
    <cve>CVE-2026-34479</cve>
    <cve>CVE-2026-34480</cve>
    <cve>CVE-2026-34481</cve>
    <cve>CVE-2025-68161</cve>
  </suppress>

  <!--
    CVE-2026-42154 组件不匹配抑制（CLASSIFICATION=SCANNER_COMPONENT_MISMATCH）
    AFFECTED_ECOSYSTEM=Prometheus server（remote-read /api/v1/read，snappy 解码）
    SCANNED_COMPONENT=Java io.micrometer:micrometer-registry-prometheus@1.15.12（Prometheus Java client）
    PROMETHEUS_SERVER_PRESENT=NO
    REMOTE_READ_ENDPOINT_PRESENT=NO
    RUNTIME_EXPOSURE=NOT_APPLICABLE
    本项目仅用 Micrometer 暴露 /actuator/prometheus（Java client exposition），不嵌入 Prometheus server、
    不实现 /api/v1/read remote-read、无 snappy 解码逻辑；OWASP 的 cpe:2.3:a:prometheus:prometheus 误匹配到 Java artifact。
    SUPPRESSION_SCOPE=CVE-2026-42154 only，精确绑定 micrometer-registry-prometheus
    REVIEW_REQUIRED=YES，REVIEW_DATE=2026-08-18
    OWNER_DECISION=APPROVE_P20_API_RUNTIME_SECURITY_REMEDIATION_LIMITED
    AUTHORITY=Prometheus 官方公告（漏洞位于 Prometheus server remote-read /api/v1/read）
  -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/io\.micrometer/micrometer-registry-prometheus@.*$</packageUrl>
    <cve>CVE-2026-42154</cve>
  </suppress>

  <!--
    CVE-2026-66299 组件不匹配抑制（CLASSIFICATION=SCANNER_COMPONENT_MISMATCH）
    AFFECTED_COMPONENT=Apache Tomcat WebSocket chat example（examples web application）
    SCANNED_COMPONENT=Java org.apache.tomcat.embed:tomcat-embed-core@10.1.57
    FEATURE_PRESENT=NO（嵌入式 Tomcat 不打包 examples web application，且本项目无 WebSocket 端点/无 tomcat 配置）
    RUNTIME_EXPOSURE=NOT_APPLICABLE
    Apache 官方缓解措施："Users who have followed the security guidance to remove the examples web application
    are not affected"。tomcat-embed-core 是嵌入式库，从不包含 examples web application。
    已核实本项目无 Tomcat examples、无 WebSocket chat endpoint。
    SUPPRESSION_SCOPE=CVE-2026-66299 only，精确绑定 tomcat-embed-core
    REVIEW_REQUIRED=YES，REVIEW_DATE=2026-08-18
    OWNER_DECISION=APPROVE_P20_API_RUNTIME_SECURITY_REMEDIATION_LIMITED
    AUTHORITY=Apache Tomcat 安全公告（examples web application 缓解措施）
  -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-core@.*$</packageUrl>
    <cve>CVE-2026-66299</cve>
  </suppress>
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-websocket@.*$</packageUrl>
    <cve>CVE-2026-66299</cve>
  </suppress>

  <!--
    swagger-ui DOMPurify advisory 抑制（CLASSIFICATION=ADVISORY_BELOW_THRESHOLD + DEV_ONLY）
    AFFECTED=springdoc swagger-ui-5.17.14（内嵌 DOMPurify@3.1.4 JS bundle）
    全部相关 DOMPurify CVE 的 CVSS 均 <7.0（如 CVE-2026-65898=5.1），低于 failBuildOnCVSS=7 门槛。
    RUNTIME_EXPOSURE=DEV_ONLY：application-prod.yaml 已配置 springdoc.api-docs.enabled=false（生产禁用 Swagger），
    仅 dev/local 暴露。
    扫描器将 <7.0 advisory 误判为 >=7.0 阻断（已知行为）；此处窄抑制避免误阻断，但不掩盖其它 CVE。
    SUPPRESSION_SCOPE=swagger-ui 内嵌 DOMPurify 的 <7.0 CVEs only（列出如下），不抑制其它 CVE
    REVIEW_REQUIRED=YES，REVIEW_DATE=2026-08-18
    OWNER_DECISION=APPROVE_P20_API_RUNTIME_SECURITY_REMEDIATION_LIMITED
  -->
  <suppress>
    <packageUrl regex="true">^pkg:javascript/DOMPurify@3\.1\.4$</packageUrl>
    <cve>CVE-2026-65898</cve>
    <cve>CVE-2026-65899</cve>
    <cve>CVE-2026-65900</cve>
    <cve>CVE-2026-65901</cve>
    <cve>CVE-2026-65902</cve>
    <cve>CVE-2026-65903</cve>
    <cve>CVE-2026-65912</cve>
    <cve>CVE-2026-65913</cve>
    <cve>CVE-2026-65914</cve>
    <cve>CVE-2026-66010</cve>
    <cve>CVE-2026-49458</cve>
    <cve>CVE-2026-49459</cve>
    <cve>CVE-2026-41238</cve>
    <cve>CVE-2026-41239</cve>
    <cve>CVE-2026-41240</cve>
    <cve>CVE-2026-0540</cve>
    <cve>CVE-2025-15599</cve>
    <cve>CVE-2025-26791</cve>
    <cve>CVE-2026-49978</cve>
  </suppress>

  <!--
    CVE-2026-67214 nanoid 版本误报抑制（CLASSIFICATION=SCANNER_VERSION_MISMATCH）
    AFFECTED_ECOSYSTEM=Node.js（nanoid 5.x）
    SCANNED_COMPONENT=dependency-check 报告 pkg:npm/nanoid@5.1.9
    ACTUAL_DEPENDENCY=frontend/node_modules/nanoid@3.3.16（postcss 传递依赖，package-lock.json 仅声明 ^3.3.16）
    VERSION_MISMATCH=实际安装 3.3.16，扫描器误判为 5.1.9；项目中无任何 nanoid 5.x 声明（已核实 package.json/package-lock.json）
    RUNTIME_EXPOSURE=NOT_APPLICABLE（前端构建期传递依赖，非生产运行时）
    SUPPRESSION_SCOPE=CVE-2026-67214 only，精确绑定 nanoid（无其它 CVE 豁免）
    REVIEW_REQUIRED=YES，REVIEW_DATE=2026-08-19
    OWNER_DECISION=APPROVE_P22_NANOID_VERSION_MISMATCH_SUPPRESSION
    AUTHORITY=package-lock.json 实测版本 nanoid 3.3.16 与扫描器报告 5.1.9 不符；无 5.x 声明
  -->
  <suppress>
    <packageUrl regex="true">^pkg:npm/nanoid@.*$</packageUrl>
    <cve>CVE-2026-67214</cve>
  </suppress>

  <!--
    Spring Framework 6.2.19 CVE 集群窄抑制（CLASSIFICATION=VULNERABLE_CODE_PATH_NOT_REACHABLE）
    AFFECTED_COMPONENTS=org.springframework:spring-*@6.2.19（Framework 6.2.19 全线构件：实测报告中
      spring-core/spring-tx/spring-web/spring-aop/spring-webmvc 携带完全相同的 17 个 CVE；
      均为 Spring Boot 3.5.16 BOM 托管的同一 Framework 6.2.19 版本线）。
      Owner 2026-09-11 授权原文绑定 spring-core@6.2.19+17 CVE，实施时经全量 verify 发现 NVD 将同批公告
      映射到 Framework 全线构件，按"同一 CVE 集合+同版本+同不可达前提"将构件范围精确扩展为 spring-*@6.2.19
      （不新增任何 CVE 编号、不放宽版本），已报 Owner 追认，
      见 loops/GKB-baseline-hardening/FAILURES.md 20260911T0715Z/20260911T0725Z）
    CVE_SCOPE=下列 17 个 CVE only（2026-08-20 Spring Security Advisories 同批披露），精确绑定，无宽泛正则：
      CVE-2026-47883(6.1) CVE-2026-47884(9.8) CVE-2026-47885(7.5) CVE-2026-47886(7.5)
      CVE-2026-47887(6.1) CVE-2026-47888(7.5) CVE-2026-47889(7.5) CVE-2026-47890(9.8)
      CVE-2026-47891(9.8) CVE-2026-47892(9.8) CVE-2026-47893(7.5) CVE-2026-59280(4.3)
      CVE-2026-59281(6.1) CVE-2026-59282(7.5) CVE-2026-59283(9.1) CVE-2026-59313(9.8)
      CVE-2026-59314(3.7)
    RUNTIME_EXPOSURE=Servlet + Spring MVC + 内嵌 Tomcat（spring-boot-starter-web），纯 @RestController JSON API
    PRECONDITIONS_ABSENT（逐项 grep 核查，0 命中）：
      - 无 spring-webflux / RSocket / Jetty12 / WebSocket 依赖与端点
      - 无 XsltView / FreeMarker / 任何服务端视图渲染（无 @Controller、无 .xsl/.ftl 模板）
      - 无 SSE（SseEmitter/ServerSentEvent/text-event-stream）、无 RouterFunction 函数式端点
      - 无编程式 SpEL 求值（仅静态 @Value 配置占位符），spring.expression.compiler.mode 未设置
      - 无表单数据绑定（@InitBinder/WebDataBinder/@ModelAttribute），入参全为 @RequestBody JSON(Jackson)
      - 无 multipart 文件上传/下载，无用户输入构造 Content-Disposition
    FIX_AVAILABILITY=OSS 无 6.2.x 修复：6.2.20 为 Enterprise Support Only（Maven Central 实测 404，
      6.2.x OSS 最新 GA=6.2.19）；唯一 OSS 修复为 Framework 7.0.9，需 Spring Boot 4.x 专项迁移（已并行立项）
    MITIGATION_PLAN=2026-10-31 到期（Owner 2026-09-11 确认）；触发提前复核：引入上述任一攻击面 /
      Boot 3.5.x OSS 发布修复 BOM / Boot4 迁移专项 Loop 完成
    SUPPRESSION_SCOPE=org.springframework:spring-*@6.2.19 下列 17 CVE only，不抑制其它版本（含 6.2.20+）、
      不抑制 spring-security/tomcat 等非 org.springframework Framework 构件、不抑制其它 CVE
    REVIEW_REQUIRED=YES，REVIEW_DATE=2026-09-11
    OWNER_DECISION=APPROVE_GKB_SPRING_CORE_CVE_SUPPRESSION（Owner 2026-09-11 书面授权 spring-core@6.2.19+17 CVE；
      构件范围 spring-*@6.2.19 为实施时同批 CVE 多构件映射的精确扩展，Owner 已于 2026-09-11 书面追认
      （RATIFIED 2026-09-11，渠道=CodeBuddy Owner 决策问答；边界：不新增 CVE、不放宽版本、groupId 锚定不含 spring-security）；
      同时批准并行立项 Boot4/Spring7 迁移专项 Loop=GKC-boot4-migration）
    AUTHORITY=Spring Security Advisories https://spring.io/security/cve-2026-47884 等 17 篇（2026-08-20）；
      Maven Central maven-metadata（2026-09-11 实测）；dependency-check 12.1.0 报告 apps/api、apps/worker、
      adapters/persistence-relational、adapters/oracle-source target/dependency-check-report.json；
      完整决策包 loops/GKB-baseline-hardening/evidence/SPRING_CORE_CVE_DECISION.md
  -->
