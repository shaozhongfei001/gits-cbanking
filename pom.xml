<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.gien.gits</groupId>
  <artifactId>gits-knowledge-engineering</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>GITS Knowledge Engineering</name>

  <properties>
    <java.version>21</java.version>
    <spring-modulith.version>1.4.12</spring-modulith.version>
    <jena.version>6.2.0</jena.version>
    <!--
      P1d: Tomcat 安全治理（APPROVE_P20_API_RUNTIME_SECURITY_REMEDIATION_LIMITED）。
      tomcat-embed-* 10.1.55 落入多个受影响版本区间（CVE-2026-55276/53434/53404/59083/59084/66299）。
      Maven Central 最新可用 10.1.x 为 10.1.57（10.1.58 未发布）；统一覆盖 Spring Boot 3.5.16 BOM
      的 10.1.55，保持 10.1.x 线、不升级 Tomcat 11、不改变 Spring Boot 主/次版本。
      所有 tomcat-embed-core/el/websocket 统一到该版本，避免漂移。

      GKD（2026-09-11，Owner 裁决决策 2=选项 B，APPROVE_GKD_TOMCAT_10_1_59_PATCH）：
      10.1.57 命中 9 个 CVSS>=7 容器特性 CVE（65637/65905/65182/68525/65183/66422/68569/65927/68763），
      经逐项可达性分析在本仓无状态 JSON REST + 自定义 X-API-KEY 架构下均不可达（无 Realm/Authenticator/
      RewriteValve/AJP/HTTP2/UDS/WebSocket 端点/security-role-ref）。公告修复边界 10.1.58 但 Maven Central
      实测 404，最小可得 GA=10.1.59（jar+pom 200）。同 10.1.x patch 线最小升级，不动 Boot/Framework 主版本。
      决策包 loops/GKD-baseline-cve-remediation/evidence/BASELINE_CVE_DECISION.md。
    -->
    <tomcat.version>10.1.59</tomcat.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>modules/operational-ontology</module>
    <module>modules/semantic-runtime</module>
    <module>modules/context-evidence</module>
    <module>modules/human-action</module>
    <module>modules/evaluation</module>
    <module>modules/scenario-customer-journey</module>
    <module>modules/knowledge-architecture</module>
    <module>scenario/execute</module>
    <module>adapters/semantic-jena</module>
    <module>adapters/persistence-relational</module>
    <module>adapters/oracle-source</module>
    <module>adapters/knowledge-filesystem</module>
    <module>apps/api</module>
    <module>apps/worker</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter</artifactId>
        <version>3.0.4</version>
      </dependency>
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-arq</artifactId>
        <version>${jena.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-shacl</artifactId>
        <version>${jena.version}</version>
      </dependency>
      <!--
        P1c: mysql-connector-j 基线安全治理。
        9.7.0-9.7.1 受 CVE-2026-60586/60623 影响；Maven Central 无 9.7.x 补丁，
        最小兼容非受影响稳定版本为 9.6.0（同 9.x 系列，非大版本升级）。覆盖 Spring Boot BOM 的 9.7.0。
      -->
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>9.6.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.2</version>
          <executions>
            <execution>
              <id>enforce-toolchain</id>
              <goals><goal>enforce</goal></goals>
              <configuration>
                <rules>
                  <requireJavaVersion><version>[21,22)</version></requireJavaVersion>
                  <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <!-- P16 G10: OWASP 依赖安全检查 -->
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>12.1.0</version>
        <executions>
          <execution>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
        <configuration>
          <failBuildOnCVSS>7</failBuildOnCVSS>
          <!-- 扫描器执行/数据源错误必须 FAIL（fail-closed），不因网络 401 等静默 PASS。 -->
          <failOnError>true</failOnError>
          <!-- OSS Index 为可选外部 analyzer；当前环境无 API 凭据且返回 401。
               依项目安全策略明确禁用，主数据源 NVD 本地 analyzer 仍启用，
               并由 scripts/dependency-check-guard.py 校验报告完整性/NVD 数据新鲜度。 -->
          <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
          <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
          <!-- 生成 JSON 报告供 completeness guard 校验结构化数据。 -->
          <formats>
            <format>HTML</format>
            <format>JSON</format>
          </formats>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
