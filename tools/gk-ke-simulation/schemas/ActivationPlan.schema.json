{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/gk-ke/v1/ActivationPlan.schema.json",
  "title": "ActivationPlan",
  "description": "独立候选交换剖面；SIM-only 示例约束，非现有生产合同替代。",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "gk-ke/v1"
    },
    "simulationOnly": {
      "const": true
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "mapRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "coreVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 1
    },
    "routePolicyVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "assetRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "capabilityRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "queryRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "executorRef": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "sideEffect": {
            "type": "string",
            "enum": [
              "READ_ONLY"
            ]
          }
        },
        "required": [
          "stepId",
          "executorRef",
          "dependencies",
          "sideEffect"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "permissionDecisionRef": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "enum": [
        "RESEARCH",
        "INTERPRETATION",
        "RECOMMENDATION"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "orgIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "customerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "purpose": {
          "type": "string",
          "enum": [
            "RESEARCH",
            "INTERPRETATION",
            "RECOMMENDATION"
          ]
        }
      },
      "required": [
        "tenantId",
        "orgIds",
        "customerIds",
        "purpose"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        }
      },
      "required": [
        "maxSteps",
        "maxTokens",
        "timeoutMs"
      ],
      "additionalProperties": false
    },
    "planHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "contractVersion",
    "simulationOnly",
    "planId",
    "taskId",
    "mapRef",
    "releaseId",
    "coreVersion",
    "catalogRevision",
    "routePolicyVersion",
    "assetRefs",
    "capabilityRefs",
    "queryRefs",
    "steps",
    "permissionDecisionRef",
    "purpose",
    "scope",
    "budget",
    "planHash"
  ],
  "additionalProperties": false
}
