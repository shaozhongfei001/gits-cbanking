# 前端本地开发代理目标（复制为 .env.development 或 .env.local 后按需修改）
#
# GITS Java API（默认 http://127.0.0.1:8080）
# 若后端以 --server.port=18080 启动，则覆盖为 http://127.0.0.1:18080
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# KERT 对公经营分析服务（默认 http://127.0.0.1:8107，KERT scripts/serve_analytics_api.py）
VITE_KERT_PROXY_TARGET=http://127.0.0.1:8107
