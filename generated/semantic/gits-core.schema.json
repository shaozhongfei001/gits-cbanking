{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "A controlled attempt to create a formal task or write to an authoritative system.",
      "properties": {
        "action_id": {
          "type": "string"
        },
        "confirmation_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "target_object_id": {
          "type": "string"
        },
        "target_system": {
          "type": "string"
        },
        "target_version": {
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "confirmation_id",
        "idempotency_key",
        "status",
        "target_object_id",
        "target_system",
        "target_version"
      ],
      "type": "object"
    },
    "ActivationContract": {
      "additionalProperties": false,
      "description": "激活合同。ID 空间 AC-*；登记于 specs/knowledge-architecture/activations/。",
      "properties": {
        "contract_id": {
          "type": "string"
        }
      },
      "required": [
        "contract_id"
      ],
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "description": "可激活资产。ID 空间 ASSET-*；登记于 specs/knowledge-architecture/registry/AssetVersion.json。",
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "asset_version": {
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ],
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "description": "能力（建议书 V2.0 §4.3「能力」）。权威源 specs/knowledge-architecture/registry/Capability.json（capabilityId）。",
      "properties": {
        "callable": {
          "type": "boolean"
        },
        "capability_id": {
          "type": "string"
        },
        "executor_ref": {
          "type": "string"
        },
        "side_effect": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "capability_id"
      ],
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "A typed assertion that remains separate from authoritative facts.",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "claim_id": {
          "type": "string"
        },
        "claim_status": {
          "type": "string"
        },
        "claim_type": {
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "supersedes_claim_id": {
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "type": "string"
        },
        "valid_to": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "claim_id",
        "claim_status",
        "claim_type",
        "recorded_at",
        "statement"
      ],
      "type": "object"
    },
    "CorporateGroup": {
      "additionalProperties": false,
      "description": "集团身份（建议书 V2.0 §4.3「集团」）。由 LegalEntity.groupId 与 GroupRelationship.groupId 引用；GITS 侧无独立运营类（域引用类）。",
      "properties": {
        "group_id": {
          "type": "string"
        }
      },
      "required": [
        "group_id"
      ],
      "type": "object"
    },
    "Customer": {
      "additionalProperties": false,
      "description": "Domain reference for a bank customer (semantic contract). Authoritative physical source is CTR-DATA-002 EDWCRM.A_ZHCX_CUST_BASE. Not an operational control-plane entity (ADR-0010).",
      "properties": {
        "brid": {
          "description": "Maps from BRID",
          "type": "string"
        },
        "cert_no": {
          "description": "Maps from CERTNO",
          "type": "string"
        },
        "cust_code": {
          "description": "Maps from CUSTCODE",
          "type": "string"
        },
        "cust_name": {
          "description": "Maps from CUSTNAME",
          "type": "string"
        },
        "cust_status": {
          "description": "Maps from CUSTSTATUS",
          "type": "string"
        },
        "cust_type": {
          "description": "Maps from CUSTTYPE",
          "type": "string"
        },
        "customer_id": {
          "description": "Maps from CUSTID",
          "type": "string"
        },
        "region": {
          "description": "Maps from REGION",
          "type": "string"
        }
      },
      "required": [
        "customer_id"
      ],
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "description": "A replayable evaluation result bound to all material artifact versions.",
      "properties": {
        "case_set_version": {
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "type": "string"
        },
        "evaluation_id": {
          "type": "string"
        },
        "gate_state": {
          "type": "string"
        },
        "run_manifest_id": {
          "type": "string"
        }
      },
      "required": [
        "case_set_version",
        "evaluated_at",
        "evaluation_id",
        "gate_state",
        "run_manifest_id"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A locatable source that supports, refutes or qualifies a claim.",
      "properties": {
        "content_hash": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "permission_label": {
          "type": "string"
        },
        "source_uri": {
          "format": "uri",
          "type": "string"
        },
        "source_version": {
          "type": "string"
        }
      },
      "required": [
        "content_hash",
        "evidence_id",
        "locator",
        "permission_label",
        "source_uri",
        "source_version"
      ],
      "type": "object"
    },
    "GroupRelationship": {
      "additionalProperties": false,
      "description": "集团内成员关系。实据 GroupRelationship（UUID id 为标识）。",
      "properties": {
        "from_entity_id": {
          "description": "对应 GroupRelationship.fromEntityId",
          "type": "string"
        },
        "group_id": {
          "description": "对应 GroupRelationship.groupId",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ownership_ratio": {
          "type": "integer"
        },
        "relationship_type": {
          "type": "string"
        },
        "to_entity_id": {
          "description": "对应 GroupRelationship.toEntityId",
          "type": "string"
        }
      },
      "required": [
        "from_entity_id",
        "group_id",
        "id",
        "relationship_type",
        "to_entity_id"
      ],
      "type": "object"
    },
    "HumanConfirmation": {
      "additionalProperties": false,
      "description": "A named human disposition over a candidate claim or proposal.",
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "confirmation_id": {
          "type": "string"
        },
        "confirmed_at": {
          "format": "date-time",
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "confirmation_id",
        "confirmed_at",
        "decision",
        "subject_id"
      ],
      "type": "object"
    },
    "Interaction": {
      "additionalProperties": false,
      "description": "A visit, call, message or other interaction event.",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "interaction_id": {
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "source_hash": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "channel",
        "interaction_id",
        "occurred_at",
        "source_hash"
      ],
      "type": "object"
    },
    "KnowledgeMap": {
      "additionalProperties": false,
      "description": "知识地图（ROOT/DOMAIN/TASK）。ID 空间 KM-*；权威源 specs/knowledge-architecture/maps/。仅做身份与引用定义，不承载业务语义（GK-KE 统一地图承担者论证 V1.0 §3.3 硬约束 2）。",
      "properties": {
        "map_id": {
          "description": "对应 knowledge-map.schema.json 的 mapId",
          "type": "string"
        },
        "map_type": {
          "description": "ROOT / DOMAIN / TASK",
          "type": "string"
        },
        "route_policy_ref": {
          "description": "对应 routePolicyRef",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "map_id",
        "map_type",
        "route_policy_ref",
        "version"
      ],
      "type": "object"
    },
    "LegalEntity": {
      "additionalProperties": false,
      "description": "法人/公司（建议书 V2.0 §4.3「公司」）。实据 modules/operational-ontology com.gien.gits.ontology.LegalEntity。",
      "properties": {
        "bank_customer_id": {
          "description": "对应 LegalEntity.bankCustomerId",
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        },
        "group_id": {
          "description": "对应 LegalEntity.groupId",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ownership": {
          "type": "string"
        },
        "relationship_status": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "entity_id"
      ],
      "type": "object"
    },
    "OperatingCase": {
      "additionalProperties": false,
      "description": "A durable business matter spanning multiple interactions.",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_type": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "type": "string"
        },
        "valid_to": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_type",
        "created_by",
        "purpose",
        "recorded_at",
        "status",
        "valid_from"
      ],
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "description": "产品身份（建议书 V2.0 §4.3「产品」，域引用类）。权威物理源为 KERT 产品卡 product_id（03_core/*/product-cards/PROD-*.md）；GITS 侧无产品运营类。",
      "properties": {
        "product_id": {
          "type": "string"
        }
      },
      "required": [
        "product_id"
      ],
      "type": "object"
    },
    "ProductKnowledgeCard": {
      "additionalProperties": false,
      "description": "产品知识卡。实据 ProductKnowledgeCard。",
      "properties": {
        "definition": {
          "type": "string"
        },
        "evidence_source": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "product_id"
      ],
      "type": "object"
    },
    "ProductKnowledgeVersion": {
      "additionalProperties": false,
      "description": "产品知识版本。实据 ProductKnowledgeVersion（versionId 为标识）。",
      "properties": {
        "category": {
          "description": "产品域编码",
          "type": "string"
        },
        "previous_version_id": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "product_name": {
          "type": "string"
        },
        "risk_level": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        },
        "version_number": {
          "type": "integer"
        }
      },
      "required": [
        "product_id",
        "product_name",
        "version_id",
        "version_number"
      ],
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "description": "The authoritative result or failure receipt of a controlled action.",
      "properties": {
        "action_id": {
          "type": "string"
        },
        "receipt_id": {
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "target_version_after": {
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "receipt_id",
        "received_at",
        "status"
      ],
      "type": "object"
    },
    "Skill": {
      "additionalProperties": false,
      "description": "可调用技能。ID 空间 SP-*；登记于 specs/knowledge-architecture/skills/。",
      "properties": {
        "skill_id": {
          "type": "string"
        }
      },
      "required": [
        "skill_id"
      ],
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "description": "任务（建议书 V2.0 §4.3「任务」）。实据 modules/human-action com.gien.gits.action.domain.Task。",
      "properties": {
        "assigned_to": {
          "type": "string"
        },
        "customer_id": {
          "type": "string"
        },
        "interaction_id": {
          "type": "string"
        },
        "operating_case_id": {
          "type": "string"
        },
        "parent_task_id": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "task_type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "task_id",
        "task_type"
      ],
      "type": "object"
    },
    "TaskType": {
      "additionalProperties": false,
      "description": "任务类型。取值见 activation-contract / knowledge-map 的 entrypoints.tasks（如 PRE_VISIT_PREPARATION）。",
      "properties": {
        "task_type_id": {
          "type": "string"
        }
      },
      "required": [
        "task_type_id"
      ],
      "type": "object"
    }
  },
  "$id": "https://gientech.com/gits/kno/core/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gits_kno_core",
  "version": "0.2.0"
}
