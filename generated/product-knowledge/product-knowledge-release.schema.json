  "properties": {
    "assertionManifestHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "bundleHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "cardProjectionHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evidenceManifestHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "gateReport": {
      "additionalProperties": false,
      "properties": {
        "blockingReasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "conflict": {
          "minimum": 0,
          "type": "integer"
        },
        "notApplicableApproved": {
          "minimum": 0,
          "type": "integer"
        },
        "requiredHardFieldsTotal": {
          "minimum": 0,
          "type": "integer"
        },
        "stale": {
          "minimum": 0,
          "type": "integer"
        },
        "supported": {
          "minimum": 0,
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "lifecycleState": {
      "enum": [
        "DRAFT",
        "REVIEW_READY",
        "APPROVED",
        "PUBLISHED",
        "RETIRED"
      ],
      "type": "string"
    },
    "ownerDecisionIds": {
      "items": {
        "pattern": "^DEC-[0-9]{8}-[0-9a-f]{8}$",
        "type": "string"
      },
      "type": "array"
    },
    "productIds": {
      "items": {
        "pattern": "^PROD-[A-Z]+-[0-9]{3}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "provenanceState": {
      "description": "发布包来源性质。DEMO 表示由演示/虚构材料编译（Owner 决议 DECISION-20260906-01 路径 C），不得冒充真实制度：provenanceState=DEMO 的 Release 不得进入 RECOMMENDATION_READY（INV-RLS-09），且对外呈现必须标注 DEMO。",
      "enum": [
        "VERIFIED",
        "DEMO"
      ],
      "type": "string"
    },
    "publishedAt": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "purposeFlags": {
      "additionalProperties": false,
      "properties": {
        "interpretationReady": {
          "type": "boolean"
        },
        "recommendationReady": {
          "type": "boolean"
        }
      },
      "required": [
        "interpretationReady",
        "recommendationReady"
      ],
      "type": "object"
    },
    "qualityRunId": {
      "pattern": "^QR-[0-9]{8}-[0-9a-f]{8}$",
      "type": "string"
    },
    "releaseId": {
      "pattern": "^RLS-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$",
      "type": "string"
    },
    "rulePackageHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "staleFlag": {
      "additionalProperties": false,
      "properties": {
        "isStale": {
          "type": "boolean"
        },
        "staleReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "staleSince": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "triggeringSourceVersionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "isStale"
      ],
      "type": "object"
    },
    "taxonomyVersion": {
      "type": "string"
    }
  },
  "required": [
    "releaseId",
    "productIds",
    "taxonomyVersion",
    "lifecycleState",
    "purposeFlags",
    "assertionManifestHash",
    "evidenceManifestHash",
    "cardProjectionHash",
    "rulePackageHash",
    "qualityRunId",
    "ownerDecisionIds",
    "bundleHash"
  ],
  "title": "ProductKnowledgeRelease (CTR-PK-RLS-001)",
  "type": "object",
  "x-contract": {
    "id": "CTR-PK-RLS-001",
    "loop": "L02",
    "requirement_refs": [
      "RC-PI-006",
      "RC-PI-007",
      "RC-PI-012"
    ],
    "status": "CANDIDATE",
    "version": "1.0.0-candidate"
  },
  "x-invariants": [
    "INV-RLS-01: recommendationReady=true => interpretationReady=true（蕴含关系）",
    "INV-RLS-02: 任一 REQUIRED_HARD 字段为 UNKNOWN / CONFLICT / STALE => 两个 purposeFlag 均为 false",
    "INV-RLS-03: NOT_APPLICABLE 的 REQUIRED_HARD 字段必须有 Owner ReviewDecision",
    "INV-RLS-04: cardProjection 与 RulePackage 只能引用本 Release 的 manifests",
    "INV-RLS-05: lifecycleState=PUBLISHED 后内容任何变化必须产生新 releaseId，禁止原地修改",
    "INV-RLS-06: staleFlag.isStale=true => recommendationReady 视为 false（消费侧强制）",
    "INV-RLS-07: bundleHash = SHA-256(assertionManifestHash || evidenceManifestHash || cardProjectionHash || rulePackageHash)",
    "INV-RLS-08: 引用了 usage=VERIFICATION_ONLY 证据的字段不得计入 REQUIRED_HARD 的 SUPPORTED",
    "INV-RLS-09: provenanceState=DEMO => recommendationReady=false（演示知识不得冒充真实制度）"
  ]
}
