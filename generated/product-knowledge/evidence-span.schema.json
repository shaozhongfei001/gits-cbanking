    }
  ],
  "properties": {
    "applicabilityScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "customerSegment": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "effectiveFrom": {
          "format": "date",
          "type": "string"
        },
        "effectiveTo": {
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "effectiveFrom"
      ],
      "type": "object"
    },
    "authorityLevel": {
      "enum": [
        "INTERNAL_POLICY",
        "REGULATORY",
        "PUBLIC_PRICE_DISCLOSURE",
        "PUBLIC_MARKETING"
      ],
      "type": "string"
    },
    "claimType": {
      "description": "本证据可支撑的断言类型。必须包含于 SourceDocument.allowedClaimTypes。",
      "enum": [
        "PRICE",
        "ELIGIBILITY",
        "PROCESS",
        "RISK",
        "REGULATORY"
      ],
      "type": "string"
    },
    "evidenceId": {
      "description": "确定性 ID。后缀必须为 SHA-256(quote) 前 8 位十六进制，禁止使用 Python 内置 hash() 等非确定性来源（见 FAILURES F-L00-01）。",
      "pattern": "^EVS-[A-Z0-9]+-[0-9a-f]{8}$",
      "type": "string"
    },
    "extractionRunId": {
      "description": "抽取运行 ID，用于重放与质量归因。",
      "pattern": "^RUN-[0-9]{8}-[0-9a-f]{8}$",
      "type": "string"
    },
    "fragmentId": {
      "description": "Fragment 主键。证据必须落在某个已切分 Fragment 内，不允许跨 Fragment 引用。",
      "pattern": "^FRG-[A-Z0-9-]+-[0-9]{4}$",
      "type": "string"
    },
    "locator": {
      "description": "三种定位方式互斥。",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bbox": {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            "kind": {
              "const": "PAGE_BBOX"
            },
            "page": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "page",
            "bbox"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "clause": {
              "minLength": 1,
              "type": "string"
            },
            "clauseVerified": {
              "default": false,
              "description": "条款号是否经 Owner 核定。false 时该证据不得支撑 RECOMMENDATION_READY。",
              "type": "boolean"
            },
            "kind": {
              "const": "CLAUSE"
            }
          },
          "required": [
            "kind",
            "clause"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "charEnd": {
              "minimum": 1,
              "type": "integer"
            },
            "charStart": {
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "CHAR_RANGE"
            }
          },
          "required": [
            "kind",
            "charStart",
            "charEnd"
          ],
          "type": "object"
        }
      ],
      "type": "object"
    },
    "quote": {
      "description": "逐字引用。必须能在 sourceVersionId 指定 Fragment 内原样定位。禁止改写、摘要或翻译。",
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "quoteHash": {
      "description": "SHA-256(quote) 的完整十六进制。不变式：quoteHash === sha256(quote)。",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "retrievedAt": {
      "format": "date-time",
      "type": "string"
    },
    "sourceBytesHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "sourceId": {
      "pattern": "^(SRC|REG|PUB)-[A-Z0-9-]+$",
      "type": "string"
    },
    "sourcePath": {
      "description": "双区前缀强制。与 usage 必须一致。",
      "pattern": "^01_raw/(_authoritative|_public_reference)/.+$",
      "type": "string"
    },
    "sourceVersionId": {
      "description": "SourceVersion 主键。不可变。格式 SV-{sourceId 去横线}-{YYYYMMDD}-{bytesHash 前8位}。",
      "pattern": "^SV-[A-Z0-9-]+-[0-9]{8}-[0-9a-f]{8}$",
      "type": "string"
    },
    "usage": {
      "description": "由 sourcePath 所在区决定，不可人工指定。_public_reference/ 恒为 VERIFICATION_ONLY。",
      "enum": [
        "AUTHORITATIVE",
        "VERIFICATION_ONLY"
      ],
      "type": "string"
    }
  },
  "required": [
    "evidenceId",
    "sourceId",
    "sourceVersionId",
    "fragmentId",
    "locator",
    "quote",
    "quoteHash",
    "usage",
    "authorityLevel",
    "claimType",
    "applicabilityScope",
    "extractionRunId",
    "retrievedAt"
  ],
  "title": "EvidenceSpan (CTR-PK-EVS-002)",
  "type": "object",
  "x-contract": {
    "compatibility_note": "EVS-002 为新增合同，不替换 EVR-001。EVR-001 保持 v1 有效，既有 69 条实例无需迁移。EVS-002 的 evidenceId 可与 EVR-001 的 evidenceRefId 建立 1:1 映射，但 EVS-002 额外要求的 5 个字段无法从 EVR-001 反推，故为 explicit_migration。",
    "compatible_with": "CTR-PK-EVR-001",
    "id": "CTR-PK-EVS-002",
    "loop": "L02",
    "requirement_refs": [
      "RC-PI-002",
      "RC-PI-003",
      "RC-PI-004"
    ],
    "status": "CANDIDATE",
    "supersedes": null,
    "version": "2.0.0-candidate"
  },
  "x-invariants": [
    "INV-EVS-01: quoteHash = SHA-256(quote)",
    "INV-EVS-02: quote 必须能在 sourceVersionId 指定 Fragment 内定位",
    "INV-EVS-03: sourcePath 以 _public_reference/ 开头 => usage = VERIFICATION_ONLY",
    "INV-EVS-04: sourcePath 以 _authoritative/ 开头 => usage = AUTHORITATIVE",
    "INV-EVS-05: claimType 必须 ∈ SourceDocument.allowedClaimTypes",
    "INV-EVS-06: usage = VERIFICATION_ONLY 的证据不得进入任何 Release 用途门槛",
    "INV-EVS-07: locator.kind = CLAUSE 且 clauseVerified = false => 不得支撑 RECOMMENDATION_READY",
    "INV-EVS-08: evidenceId 后缀必须等于 SHA-256(quote) 前 8 位（确定性要求）",
    "INV-EVS-09: sourceVersionId 指向 provenanceState=DEMO 的源时，本证据不得支撑 RECOMMENDATION_READY（演示制度不得冒充真实制度）",
    "INV-EVS-10: provenanceState=DEMO 的证据其 usage 仍按区判定，但必须被 Release 标 provenanceState=DEMO 后方可进入 INTERPRETATION_READY",
    "INV-EVS-11: DEMO 证据不得与 VERIFIED 证据混合支撑同一字段断言（禁止用演示材料补真实材料缺口）"
  ]
}
