  "info": {
    "description": "KERT → GITS 产品解读查询 API。三视图只呈现已发布 Release 中被支持的结论，并可回链证据。Loop L02 候选，未冻结，未生成 SDK。",
    "title": "Product Interpretation API (CTR-PK-INT-001)",
    "version": "1.0.0-candidate"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/product-knowledge/{productId}/interpretation": {
      "get": {
        "operationId": "getProductInterpretation",
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "pattern": "^PROD-[A-Z]+-[0-9]{3}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "view",
            "required": true,
            "schema": {
              "enum": [
                "OVERVIEW",
                "ELIGIBILITY",
                "PRICING"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "purpose",
            "required": true,
            "schema": {
              "enum": [
                "INTERPRETATION",
                "RECOMMENDATION"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "asOf",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterpretationResponse"
                }
              }
            },
            "description": "解读结果"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "参数错误（productId 格式非法、view/purpose 取值非法或缺失）"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "产品无已发布 Release"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Release 已 stale"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "用途不被允许（仅候选或公开轨知识）"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "受控失败"
          }
        },
        "summary": "获取产品解读三视图"
      }
    }
  },
  "x-contract": {
    "id": "CTR-PK-INT-001",
    "loop": "L02",
    "requirement_refs": [
      "RC-PI-008",
      "RC-PI-011"
    ],
    "status": "CANDIDATE"
  }
}
