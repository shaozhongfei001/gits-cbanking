{
  "components": {
    "parameters": {
      "CorrelationId": {
        "description": "关联 ID，贯穿日志。",
        "in": "header",
        "name": "X-Correlation-Id",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "ExpectedVersion": {
        "description": "乐观锁 expectedVersion。C06 §1 要求 mutation 使用 expectedVersion；过期返回 409。",
        "in": "header",
        "name": "If-Match-Version",
        "required": false,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "description": "mutation 幂等键。相同键同请求返回原结果；不同 payload 返回 IDEMPOTENCY_CONFLICT（409）。",
        "in": "header",
        "name": "Idempotency-Key",
        "required": false,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "TraceId": {
        "description": "链路追踪 ID，贯穿日志。",
        "in": "header",
        "name": "X-Trace-Id",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "409 业务冲突（幂等键冲突 / 并发版本过期 / hash 变化 / 路由歧义 / 依赖未解析）"
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "403 越权/未确认/自审"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "404 资源不存在或未解析"
      },
      "ServiceUnavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "503 依赖失效（图不可用 / 依赖服务不可用）；不代表 200 空结果。"
      },
      "UnprocessableEntity": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "422 语义校验失败（用途不允许 / 粒度缺失 / 币种 / 白名单外动作）"
      }
    },
    "schemas": {
      "ActivationPlan": {
        "$ref": "../../gk-ke/v1/schemas/ActivationPlan.schema.json"
      },
      "ActivationPlanRequest": {
        "additionalProperties": false,
