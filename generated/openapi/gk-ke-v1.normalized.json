          "budget": {
            "additionalProperties": false,
            "properties": {
              "maxInitialTokens": {
                "minimum": 1,
                "type": "integer"
              },
              "maxRows": {
                "minimum": 1,
                "type": "integer"
              },
              "timeoutMs": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "dependencyVersions": {
            "additionalProperties": {
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "type": "string"
            },
            "type": "object"
          },
          "expectedVersion": {
            "minLength": 1,
            "type": "string"
          },
          "mapRelease": {
            "$ref": "#/components/schemas/VersionedRef"
          },
          "purpose": {
            "enum": [
              "RESEARCH",
              "INTERPRETATION",
              "RECOMMENDATION"
            ],
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/RequestScope"
          },
          "taskContext": {
            "additionalProperties": false,
            "properties": {
              "asOf": {
                "format": "date-time",
                "type": "string"
              },
              "customerId": {
                "type": "string"
              },
              "taskId": {
                "minLength": 1,
                "type": "string"
              },
              "taskType": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "taskId",
              "taskType"
            ],
            "type": "object"
          }
        },
        "required": [
          "taskContext",
          "mapRelease",
          "dependencyVersions",
          "expectedVersion",
          "purpose",
          "scope"
        ],
        "type": "object"
      },
      "Assertion": {
        "$ref": "../../gk-ke/v1/schemas/Assertion.schema.json"
      },
      "AssetVersion": {
        "$ref": "../../gk-ke/v1/schemas/AssetVersion.schema.json"
      },
      "Capability": {
        "$ref": "../../gk-ke/v1/schemas/Capability.schema.json"
      },
