        "VERIFIED",
        "PENDING_VERIFICATION",
        "APPROVAL_VARIABLE",
        "PRICING_VARIABLE",
        "CONFLICTING",
        "EXPIRED",
        "NOT_APPLICABLE"
      ],
      "type": "string"
    },
