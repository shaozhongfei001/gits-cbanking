{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/gk-ke/v1/GraphRequest.schema.json",
  "title": "GraphRequest",
  "description": "独立候选交换剖面；SIM-only 示例约束，非现有生产合同替代。",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "gk-ke/v1"
    },
    "simulationOnly": {
      "const": true
    },
    "queryId": {
      "type": "string",
      "enum": [
        "SIM-GQ-HOLDINGS"
      ]
    },
    "queryVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "entityId": {
      "type": "string",
      "minLength": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "maxHops": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "maxNodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "scope": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "orgIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "customerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "purpose": {
          "type": "string",
          "enum": [
            "RESEARCH",
            "INTERPRETATION",
            "RECOMMENDATION"
          ]
        }
      },
      "required": [
        "tenantId",
        "orgIds",
        "customerIds",
        "purpose"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "simulationOnly",
    "queryId",
    "queryVersion",
    "entityId",
    "releaseId",
    "maxHops",
    "maxNodes",
    "scope"
  ],
  "additionalProperties": false
}
