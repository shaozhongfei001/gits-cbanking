{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gientech.com/gits/product-recommendation/run.schema.json",
  "title": "ProductRecommendationRun",
  "description": "一次产品推荐业务运行（三段式决策的生命周期容器）。GITS 主责业务状态机；KERT 只维护 Skill 执行作业状态，不成为业务审批状态的第二权威源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "customerId",
    "status",
    "idempotencyKey",
    "asOf",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "runId": { "type": "string" },
    "customerId": { "type": "string" },
    "journeyId": { "type": "string" },
    "operatingCaseId": { "type": "string" },
    "needVersionIds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "唯一权威 Need 版本引用；推荐只能基于已核验或显式标为假设的 Need"
    },
    "recommendationObjective": {
      "type": "string",
      "description": "推荐目的；不允许空泛的'给我推荐产品'"
    },
    "requestedProductDomains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "asOf": { "type": "string", "format": "date-time", "description": "业务时点" },
    "idempotencyKey": { "type": "string", "description": "幂等范围 = caller + customerId + journeyId/operatingCaseId + objectiveHash + asOf" },
    "status": { "$ref": "#/$defs/RecommendationRunStatus" },
    "currentVersionId": { "type": "string", "description": "当前不可变方案版本 ID" },
    "kertJobRef": { "type": "string", "description": "KERT Skill 执行作业引用" },
    "snapshotRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customerFactSnapshotId": { "type": "string" },
        "productKnowledgeSnapshotRef": { "type": "string" },
        "ruleBundleRef": { "type": "string" },
        "evidenceBundleId": { "type": "string" }
      }
    },
    "attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/RecommendationAttempt" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "RecommendationRunStatus": {
      "type": "string",
      "enum": [
        "REQUESTED",
        "CONTEXT_ASSEMBLING",
        "HARD_FILTERING",
        "MATCHING",
        "PROPOSAL_READY",
        "AWAITING_HUMAN",
        "APPROVED",
        "MODIFIED",
        "REJECTED",
        "HELD",
        "STALE_REQUIRES_RERUN",
        "FAILED_CLOSED"
      ]
    },
    "RecommendationAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "kertRequestId", "startedAt", "status"],
      "properties": {
        "attemptId": { "type": "string" },
        "kertRequestId": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["SUBMITTED", "RUNNING", "SUCCEEDED", "FAILED", "TIMEOUT", "CONTRACT_MISMATCH"] },
        "errorCode": { "type": "string", "description": "KERT_* 错误码" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
