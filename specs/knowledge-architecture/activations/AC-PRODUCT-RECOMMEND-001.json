{
  "schemaVersion": "1.0.0",
  "contractId": "AC-PRODUCT-RECOMMEND-001",
  "version": "0.1.0",
  "taskType": "PRODUCT_RECOMMENDATION_DECISION",
  "routeMode": "ONTOLOGY_THEN_MAP",
