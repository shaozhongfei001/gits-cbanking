    "snapshotId": "SIM-SNAPSHOT-20261001",
    "source": "C04 section 3 + C07 section 5"
  },

  "errorBehavior": {
    "METRIC_NOT_REGISTERED": "拒绝执行",
    "RAW_QUERY_FORBIDDEN": "拒绝执行",
    "GRAIN_VIOLATION": "拒绝返回确定数值，报告源质量问题",
