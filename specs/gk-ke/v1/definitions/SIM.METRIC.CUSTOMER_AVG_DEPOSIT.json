    "SCOPE_DENIED": "拒绝，审计中不泄漏被拒对象细节",
    "SNAPSHOT_UNAVAILABLE": "不以最新数据伪装历史复算",
    "QUERY_BUDGET_EXCEEDED": "终止并记 queryRunId"
  },

  "provenance": {
