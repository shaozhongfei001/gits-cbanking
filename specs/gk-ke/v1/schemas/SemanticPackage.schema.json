{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/gk-ke/v1/SemanticPackage.schema.json",
  "title": "SemanticPackage",
  "description": "独立候选交换剖面；SIM-only 示例约束，非现有生产合同替代。L1-1：12 个最小类型（9 公共核心 + 3 域扩展）、双版本引用、ID/时间/金额规范。依据 C01 §3 与 C08 L1-1。",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "gk-ke/v1"
    },
    "simulationOnly": {
      "const": true
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "description": "公共核心包标识；ownerSystem 为 CORE 时须为 SIM-CORE。"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "coreVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "L1-1 双版本引用之「核心语义版本」：本包所遵循的公共核心语义规范版本。与 version（本包自身内容版本）分别登记，即使取值相同也不得视为同一字段。"
    },
    "ownerSystem": {
      "type": "string",
      "enum": [
        "CORE"
      ]
    },
    "idConvention": {
      "$comment": "L1-1：ID 规范。见 C01 §2 对象级唯一权威与 §3 最小共享类型。",
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "enum": [
            "STABLE_OPAQUE"
          ],
          "description": "稳定不透明标识；不得以名称替代身份。"
        },
        "immutable": {
          "const": true
        },
        "nameSubstitutionForbidden": {
          "const": true,
          "description": "相同名称、不同登记主体不得自动 sameAs；合户须经身份解析规则与人工例外。"
        },
        "namespacePattern": {
          "type": "string",
          "minLength": 1,
          "description": "例如 ^SIM-[A-Z0-9-]+$（模拟命名空间）。"
        }
      },
      "required": ["scheme", "immutable", "nameSubstitutionForbidden"],
      "additionalProperties": false
    },
    "timeConvention": {
      "$comment": "L1-1：时间规范。左闭右开 [from,to)；业务日期 Asia/Shanghai；记录时间为带时区 UTC 时间戳。",
      "type": "object",
      "properties": {
        "intervalNotation": {
          "const": "LEFT_CLOSED_RIGHT_OPEN",
          "description": "[from, to)"
        },
        "businessDateZone": {
          "const": "Asia/Shanghai"
        },
        "recordedAtFormat": {
          "const": "RFC3339_UTC_WITH_OFFSET",
          "description": "如 2026-09-12T10:00:00Z 或带 +08:00 偏移。"
        }
      },
      "required": ["intervalNotation", "businessDateZone", "recordedAtFormat"],
      "additionalProperties": false
    },
    "moneyConvention": {
      "$comment": "L1-1：金额规范。十进制字符串或整数分；强制 currency 与 unit。",
      "type": "object",
      "properties": {
        "representation": {
          "type": "string",
          "enum": ["DECIMAL_STRING", "INTEGER_MINOR_UNIT"]
        },
        "decimalPattern": {
          "type": "string",
          "description": "DECIMAL_STRING 时的正则，例如 ^-?\\d+(\\.\\d+)?$。禁止浮点。"
        },
        "currencyRequired": {
          "const": true
        },
        "unitRequired": {
          "const": true
        },
        "stockVsFlow": {
          "type": "string",
          "enum": ["STOCK", "FLOW", "INTENT", "LIMIT", "DRAWABLE"],
          "description": "账户余额是存量（STOCK），交易金额是流量（FLOW），意向金额是声明（INTENT），额度（LIMIT）与可提款金额（DRAWABLE）分别建模，不得互相替代。"
        },
        "fxShape": {
          "type": "object",
          "properties": {
            "base": {"type": "string", "minLength": 1},
            "quote": {"type": "string", "minLength": 1},
            "rate": {"type": "string", "pattern": "^-?\\d+(\\.\\d+)?$"},
            "rateDate": {"type": "string", "format": "date"},
            "sourceRef": {"type": "string", "minLength": 1}
          },
          "required": ["base", "quote", "rate", "rateDate", "sourceRef"],
          "additionalProperties": false
        }
      },
      "required": ["representation", "currencyRequired", "unitRequired"],
      "additionalProperties": false
    },
    "types": {
      "type": "array",
      "description": "L1-1：至少 12 个最小类型（9 公共核心 + 3 域扩展）。typeId 须唯一。",
      "items": {
        "type": "object",
        "properties": {
          "typeId": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "description": "中文定义。"
          },
          "identityRule": {
            "type": "string",
            "minLength": 1,
            "description": "主键语义。"
          },
          "origin": {
            "type": "string",
            "enum": ["CORE", "DOMAIN"],
            "description": "CORE = C01 §3 最小共享类型；DOMAIN = 领域包扩展类型。"
          },
          "attributeTypes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "description": "属性类型清单。"
          },
          "requiredAttributes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "targetTypeId": {"type": "string", "minLength": 1},
                "cardinality": {
                  "type": "string",
                  "enum": ["1", "0..1", "1..*", "0..*"]
                }
              },
              "required": ["targetTypeId", "cardinality"],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "temporal": {
            "type": "string",
            "enum": ["TEMPORAL", "NON_TEMPORAL"],
            "description": "时态标记。"
          },
          "sensitive": {
            "type": "string",
            "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"],
            "description": "敏感标记。"
          },
          "writeOwner": {
            "type": "string",
            "minLength": 1
          },
          "writeEntry": {
            "type": "string",
            "minLength": 1
          },
          "authorityScope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "typeId",
          "definition",
          "identityRule",
          "origin",
          "attributeTypes",
          "requiredAttributes",
          "temporal",
          "sensitive"
        ],
        "additionalProperties": false
      },
      "minItems": 12
    },
    "imports": {
      "type": "array",
      "description": "L1-1 双版本引用：领域包引用 corePackageId/version/hash；共享类型不得复制后改义。",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "packageKind": {
            "type": "string",
            "enum": ["CORE", "DOMAIN"]
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "contractVersion",
    "simulationOnly",
    "packageId",
    "version",
    "coreVersion",
    "ownerSystem",
    "idConvention",
    "timeConvention",
    "moneyConvention",
    "types",
    "imports"
  ],
  "additionalProperties": false,
  "x-gk-ke-package-invariants": {
    "$comment": "L1-1 包级不变式。JSON Schema 2020-12 无法表达数组内跨项唯一性或跨类型集合语义，故以机器可读不变式声明，由消费者校验器（scripts/gk_ke_l1_1_semantics_tests.py）强制执行。见 FAIL-2026-09-12-05。",
    "invariants": [
      {
        "id": "TYPEID_UNIQUE",
        "rule": "types[].typeId 在包内必须唯一",
        "covers": "同名异义（同一 typeId 重复登记但定义不同）",
        "evidence": "C08 L1-1「同名异义…测试通过」"
      },
      {
        "id": "SHARED_TYPE_NOT_FORKED",
        "rule": "origin=DOMAIN 的类型不得占用 core. 前缀命名空间（即不得复制共享类型后改义）",
        "covers": "破坏变更（共享类型被复制后改义）",
        "evidence": "C01 §3「共享类型不得复制后改义」；C08 L1-1「破坏变更…测试通过」"
      },
      {
        "id": "NO_IDENTITY_MERGE_BY_NAME",
        "rule": "idConvention.nameSubstitutionForbidden 必须为 true",
        "covers": "身份误并（相同名称不同登记主体自动 sameAs）",
        "evidence": "C01 §3「相同名称、不同登记主体不能自动 sameAs」"
      }
    ]
  }
}
