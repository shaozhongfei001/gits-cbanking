{
  "openapi": "3.1.1",
  "info": {
    "title": "Product Interpretation API (CTR-PK-INT-001)",
    "version": "1.1.0-candidate",
    "description": "KERT → GITS 产品解读查询 API。三视图只呈现已发布 Release 中被支持的结论，并可回链证据；另含 LightRAG 派生检索召回端点（PC8 · CR-5 衍生，不得作为基础闭环前置）。Loop L02 候选，未冻结，未生成 SDK。"
  },
  "x-contract": {
    "id": "CTR-PK-INT-001",
    "status": "CANDIDATE",
    "loop": "L02",
    "requirement_refs": [
      "RC-PI-008",
      "RC-PI-011"
    ]
  },
  "paths": {
    "/api/v1/product-knowledge/{productId}/interpretation": {
      "get": {
        "operationId": "getProductInterpretation",
        "summary": "获取产品解读三视图",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^PROD-[A-Z]+-[0-9]{3}$"
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "OVERVIEW",
                "ELIGIBILITY",
                "PRICING"
              ]
            }
          },
          {
            "name": "purpose",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "INTERPRETATION",
                "RECOMMENDATION"
              ]
            }
          },
          {
            "name": "asOf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "解读结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterpretationResponse"
                }
              }
            }
          },
          "400": {
            "description": "参数错误（productId 格式非法、view/purpose 取值非法或缺失）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "产品无已发布 Release",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Release 已 stale",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "用途不被允许（仅候选或公开轨知识）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "受控失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/product-knowledge/{productId}/retrieval": {
    "post": {
      "operationId": "retrieveProductKnowledge",
      "tags": [
        "ProductKnowledge"
      ],
      "summary": "LightRAG 派生检索召回（实体/关系/可回译出处）",
      "description": "PC8 · CR-5 衍生：对指定产品做 LightRAG 派生检索，返回实体/关系/出处。本端点为派生检索层，绝不参与产品解读基础闭环（不得作为前置）。KERT 不可达/鉴权失败/响应形状不符时 fail-closed 返回具名 LIGHTRAG_* 码，禁止以空结果 200 冒充成功。",
      "parameters": [
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^PROD-[A-Z]+-[0-9]{3}$"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RetrievalRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "检索命中（实体/关系/出处）",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrievalResponse"
              }
            }
          }
        },
        "400": {
          "description": "参数错误（productId 格式非法或请求体非法）",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          }
        },
        "404": {
          "description": "产品不存在",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          }
        },
        "502": {
          "description": "上游 LightRAG 返回错误或响应形状不符（LIGHTRAG_HTTP_ERROR / LIGHTRAG_RESPONSE_INVALID）",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          }
        },
        "503": {
          "description": "LightRAG 不可达（LIGHTRAG_UNAVAILABLE）",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          }
        },
        "504": {
          "description": "检索超时（LIGHTRAG_PIPELINE_TIMEOUT）",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InterpretationResponse": {
        "type": "object",
        "required": [
          "productId",
          "releaseId",
          "bundleHash",
          "view",
          "purpose",
          "fields",
          "generatedAt"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "releaseId": {
            "type": "string"
          },
          "bundleHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "view": {
            "type": "string",
            "enum": [
              "OVERVIEW",
              "ELIGIBILITY",
              "PRICING"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "INTERPRETATION",
              "RECOMMENDATION"
            ]
          },
          "isStale": {
            "type": "boolean",
            "default": false
          },
          "fields": {
            "type": "array",
            "description": "空数组表示无可呈现字段，不返回 null。",
            "items": {
              "$ref": "#/components/schemas/InterpretedField"
            }
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InterpretedField": {
        "type": "object",
        "required": [
          "fieldPath",
          "knowledgeState",
          "evidenceSummaries"
        ],
        "properties": {
          "fieldPath": {
            "type": "string"
          },
          "displayValue": {
            "type": [
              "string",
              "null"
            ],
            "description": "knowledgeState ∈ {UNKNOWN, CONFLICT, STALE} 时必须为 null，前端须显式标注状态而非留白。"
          },
          "knowledgeState": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "UNKNOWN",
              "CONFLICT",
              "NOT_APPLICABLE",
              "STALE"
            ]
          },
          "evidenceSummaries": {
            "type": "array",
            "description": "证据回链摘要。UNKNOWN 时为空数组。",
            "items": {
              "$ref": "#/components/schemas/EvidenceSummary"
            }
          },
          "conflictId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "EvidenceSummary": {
        "type": "object",
        "required": [
          "evidenceId",
          "sourceId",
          "authorityLevel",
          "locatorHint"
        ],
        "properties": {
          "evidenceId": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "sourceVersionId": {
            "type": "string"
          },
          "authorityLevel": {
            "type": "string",
            "enum": [
              "INTERNAL_POLICY",
              "REGULATORY",
              "PUBLIC_PRICE_DISCLOSURE",
              "PUBLIC_MARKETING"
            ]
          },
          "locatorHint": {
            "type": "string",
            "description": "如 '第十二条' 或 'p.1 (72,340)-(523,358)'"
          },
          "quoteExcerpt": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "error",
          "message",
          "path",
          "timestamp"
        ],
        "properties": {
          "status": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "PRODUCT_KNOWLEDGE_NOT_PUBLISHED",
              "PURPOSE_NOT_ALLOWED",
              "RELEASE_STALE",
              "KNOWLEDGE_GATE_FAILED",
              "FAILED_CLOSED",
              "BAD_REQUEST",
              "LIGHTRAG_UNAVAILABLE",
              "LIGHTRAG_HTTP_ERROR",
              "LIGHTRAG_RESPONSE_INVALID",
              "LIGHTRAG_PIPELINE_TIMEOUT",
              "PRODUCT_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "RetrievalRequest": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "检索查询语句"
        },
        "mode": {
          "type": "string",
          "enum": [
            "local",
            "global",
            "hybrid",
            "naive",
            "mix"
          ],
          "default": "hybrid",
          "description": "LightRAG 检索模式"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        }
      }
    },
    "RetrievalResponse": {
      "type": "object",
      "required": [
        "productId",
        "query",
        "mode",
        "entities",
        "relations",
        "citations",
        "evidenceClass",
        "generatedAt"
      ],
      "properties": {
        "productId": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RetrievalEntity"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RetrievalRelation"
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RetrievalCitation"
          }
        },
        "evidenceClass": {
          "type": "string",
          "enum": [
            "DERIVED_RETRIEVAL"
          ]
        },
        "provenanceState": {
          "type": "string",
          "description": "同源派生产出状态（回译到 KERT 产物）"
        },
        "simulationOnly": {
          "type": "boolean",
          "description": "是否仅为仿真（证据不足即 DEMO）"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "RetrievalEntity": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "RetrievalRelation": {
      "type": "object",
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "RetrievalCitation": {
      "type": "object",
      "required": [
        "chunkId"
      ],
      "properties": {
        "chunkId": {
          "type": "string",
          "description": "LightRAG referenceId，可回译到 KERT 产物"
        },
        "docId": {
          "type": "string",
          "description": "KERT 产物文件路径，可回译"
        },
        "content": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "planHash": {
          "type": "string"
        }
      }
    },
    "examples": {
      "positive": {
        "summary": "POSITIVE — 已发布，字段有权威证据",
        "value": {
          "productId": "PROD-CM-001",
          "releaseId": "RLS-2026.09.01.1",
          "bundleHash": "5555555555555555555555555555555555555555555555555555555555555555",
          "view": "OVERVIEW",
          "purpose": "INTERPRETATION",
          "isStale": false,
          "fields": [
            {
              "fieldPath": "compliance.regulatoryBasis",
              "displayValue": "《现金管理暂行条例》第十二条",
              "knowledgeState": "SUPPORTED",
              "conflictId": null,
              "evidenceSummaries": [
                {
                  "evidenceId": "EVS-REGCM001-3f2a9c11",
                  "sourceId": "REG-CM-001",
                  "sourceVersionId": "SV-REGCM001-20260904-105df242",
                  "authorityLevel": "REGULATORY",
                  "locatorHint": "第十二条",
                  "quoteExcerpt": "开户单位之间的经济往来，除按国家现金管理规定的范围可以使用现金外，应当通过银行进行转账结算。"
                }
              ]
            }
          ],
          "generatedAt": "2026-09-05T10:00:00+08:00"
        }
      },
      "unknownField": {
        "summary": "UNKNOWN — 无证据，displayValue 必须 null，不得由模型补齐",
        "value": {
          "productId": "PROD-CM-002",
          "releaseId": "RLS-2026.09.02.1",
          "bundleHash": "6666666666666666666666666666666666666666666666666666666666666666",
          "view": "ELIGIBILITY",
          "purpose": "INTERPRETATION",
          "isStale": false,
          "fields": [
            {
              "fieldPath": "eligibility.minAccountBalance",
              "displayValue": null,
              "knowledgeState": "UNKNOWN",
              "conflictId": null,
              "evidenceSummaries": []
            }
          ],
          "generatedAt": "2026-09-05T10:01:00+08:00"
        }
      },
      "conflictField": {
        "summary": "CONFLICT — 冲突未决，displayValue null 且带 conflictId",
        "value": {
          "productId": "PROD-CM-001",
          "releaseId": "RLS-2026.09.03.1",
          "bundleHash": "7777777777777777777777777777777777777777777777777777777777777777",
          "view": "PRICING",
          "purpose": "INTERPRETATION",
          "isStale": false,
          "fields": [
            {
              "fieldPath": "pricing.serviceFee",
              "displayValue": null,
              "knowledgeState": "CONFLICT",
              "conflictId": "CNF-PRODCM001-aabbccdd",
              "evidenceSummaries": []
            }
          ],
          "generatedAt": "2026-09-05T10:02:00+08:00"
        }
      },
      "publicTrackReject": {
        "summary": "PUBLIC_TRACK_REJECT — 仅公开轨知识，拒绝 RECOMMENDATION 用途",
        "value": {
          "status": 422,
          "error": "Unprocessable Entity",
          "code": "PURPOSE_NOT_ALLOWED",
          "message": "Release RLS-2026.09.04.1 仅含 VERIFICATION_ONLY 证据，不可用于 RECOMMENDATION 用途",
          "path": "/api/v1/product-knowledge/PROD-CM-003/interpretation",
          "timestamp": "2026-09-05T10:03:00+08:00"
        }
      },
      "staleReject": {
        "summary": "STALE — Release 已过期",
        "value": {
          "status": 409,
