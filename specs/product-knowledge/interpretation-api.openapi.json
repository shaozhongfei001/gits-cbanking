        }
      },
      "notPublished": {
        "summary": "NOT_PUBLISHED — 无发布包，GITS 不得本地兜底",
        "value": {
          "status": 404,
          "error": "Not Found",
          "code": "PRODUCT_KNOWLEDGE_NOT_PUBLISHED",
          "message": "PROD-CM-013 无已发布 Release（legacy sample 卡不可消费）",
          "path": "/api/v1/product-knowledge/PROD-CM-013/interpretation",
          "timestamp": "2026-09-05T10:05:00+08:00"
        }
      }
    }
  }
}
