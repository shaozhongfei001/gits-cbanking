{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gits.gien.com/specs/product-knowledge/conflict-case.schema.json",
  "title": "ConflictCase (CTR-PK-CNF-001)",
  "description": "字段冲突案例。同字段多来源矛盾时必须显式记录，禁止模型择一或按时间戳自动覆盖。决议只能追加，由 Owner 签发。Loop L02 候选，未冻结。",
  "x-contract": {
    "id": "CTR-PK-CNF-001",
    "version": "1.0.0-candidate",
    "status": "CANDIDATE",
    "loop": "L02",
    "requirement_refs": ["RC-PI-005", "RC-PI-006"]
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["conflictId", "productId", "fieldPath", "conflictType", "assertionIds", "status", "detectedByRunId", "detectedAt"],
  "properties": {
    "conflictId": { "type": "string", "pattern": "^CNF-[A-Z0-9-]+-[0-9a-f]{8}$" },
    "productId": { "type": "string", "pattern": "^PROD-[A-Z]+-[0-9]{3}$" },
    "fieldPath": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)*$" },
    "conflictType": {
      "type": "string",
      "enum": ["VALUE_MISMATCH", "SCOPE_OVERLAP", "AUTHORITY_TIE", "TEMPORAL_AMBIGUITY", "UNIT_MISMATCH"]
    },
    "assertionIds": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "pattern": "^ASM-[A-Z0-9-]+-[0-9a-f]{8}$" }
    },
    "impactedObjects": {
      "type": "array",
      "items": { "type": "string" },
      "description": "受影响的 productId / releaseId 列表。"
    },
    "status": {
      "type": "string",
      "enum": ["OPEN", "UNDER_REVIEW", "RESOLVED", "DEFERRED"]
    },
    "resolution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["decisionId", "resolvedAssertionId", "rationale", "resolvedBy", "resolvedAt"],
      "properties": {
        "decisionId": { "type": "string", "pattern": "^DEC-[0-9]{8}-[0-9a-f]{8}$" },
        "resolvedAssertionId": { "type": "string", "pattern": "^ASM-[A-Z0-9-]+-[0-9a-f]{8}$" },
        "rationale": { "type": "string", "minLength": 1 },
        "resolvedBy": { "type": "string" },
        "resolvedByRole": {
          "type": "string",
          "enum": ["PRODUCT_OWNER", "RISK_OWNER", "COMPLIANCE_OWNER"]
        },
        "resolvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "detectedByRunId": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9a-f]{8}$" },
    "detectedAt": { "type": "string", "format": "date-time" }
  },
  "x-invariants": [
    "INV-CNF-01: status=RESOLVED => resolution 非空且 resolvedByRole ∈ Owner 角色集",
    "INV-CNF-02: status ∈ {OPEN, UNDER_REVIEW} => 关联字段的 FieldAssertion 必须为 CONFLICT，且不得进入任何 Release",
    "INV-CNF-03: 禁止系统自动写入 resolution（AI 不得代替 Owner 决定）",
    "INV-CNF-04: resolution.resolvedAssertionId 必须 ∈ assertionIds",
    "INV-CNF-05: 决议只能追加，不得修改已有 resolution"
  ],
  "examples": [
    {
      "_case": "OPEN — 两份公开价目对同一收费项给出不同金额，不自动择一",
      "conflictId": "CNF-PRODCM001-aabbccdd",
      "productId": "PROD-CM-001",
      "fieldPath": "pricing.serviceFee",
      "conflictType": "VALUE_MISMATCH",
      "assertionIds": ["ASM-PRODCM001-9c0d1e2f", "ASM-PRODCM001-3b4c5d6e"],
      "impactedObjects": ["PROD-CM-001"],
      "status": "OPEN",
      "resolution": null,
      "detectedByRunId": "RUN-20260904-a1b2c3d4",
      "detectedAt": "2026-09-04T11:10:00+08:00"
    },
    {
      "_case": "RESOLVED — Owner 明确择定，附理由与角色",
      "conflictId": "CNF-PRODCM002-11223344",
      "productId": "PROD-CM-002",
      "fieldPath": "eligibility.minAccountBalance",
      "conflictType": "AUTHORITY_TIE",
      "assertionIds": ["ASM-PRODCM002-aaaa1111", "ASM-PRODCM002-bbbb2222"],
      "impactedObjects": ["PROD-CM-002"],
      "status": "RESOLVED",
      "resolution": {
        "decisionId": "DEC-20260905-9f8e7d6c",
        "resolvedAssertionId": "ASM-PRODCM002-aaaa1111",
        "rationale": "以行内《现金管理业务操作规程》为准，监管法规仅设下限不设具体门槛。",
        "resolvedBy": "product.owner@example",
        "resolvedByRole": "PRODUCT_OWNER",
        "resolvedAt": "2026-09-05T09:00:00+08:00"
      },
      "detectedByRunId": "RUN-20260904-a1b2c3d4",
      "detectedAt": "2026-09-04T11:12:00+08:00"
    }
  ]
}
