      "evidenceManifestHash": "2222222222222222222222222222222222222222222222222222222222222222",
      "cardProjectionHash": "3333333333333333333333333333333333333333333333333333333333333333",
      "rulePackageHash": "4444444444444444444444444444444444444444444444444444444444444444",
      "qualityRunId": "QR-20260905-55ee66ff",
      "ownerDecisionIds": [],
      "bundleHash": "7777777777777777777777777777777777777777777777777777777777777777",
      "publishedAt": null,
      "staleFlag": { "isStale": false, "staleReason": null, "staleSince": null, "triggeringSourceVersionId": null },
      "gateReport": {
        "requiredHardFieldsTotal": 4, "supported": 3, "unknown": 0,
        "conflict": 1, "stale": 0, "notApplicableApproved": 0,
        "blockingReasons": ["KNOWLEDGE_GATE_FAILED: CNF-PRODCM001-aabbccdd unresolved"]
      }
    },
    {
      "_case": "STALE — 已发布但源变更，recommendationReady 被消费侧强制视为 false",
      "releaseId": "RLS-2026.08.01.1",
      "productIds": ["PROD-CM-001"],
      "taxonomyVersion": "CTR-PK-TAX-001@v1",
      "lifecycleState": "PUBLISHED",
      "purposeFlags": { "interpretationReady": true, "recommendationReady": true },
      "assertionManifestHash": "1111111111111111111111111111111111111111111111111111111111111111",
      "evidenceManifestHash": "2222222222222222222222222222222222222222222222222222222222222222",
