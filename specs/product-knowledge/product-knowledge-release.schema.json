      "ownerDecisionIds": ["DEC-20260801-abcdef01"],
      "bundleHash": "8888888888888888888888888888888888888888888888888888888888888888",
      "publishedAt": "2026-08-01T10:00:00+08:00",
      "staleFlag": {
        "isStale": true,
        "staleReason": "RELEASE_STALE: SV-REGCM001-20260904-105df242 supersedes prior version",
        "staleSince": "2026-09-04T10:00:00+08:00",
        "triggeringSourceVersionId": "SV-REGCM001-20260904-105df242"
      },
      "gateReport": {
        "requiredHardFieldsTotal": 4, "supported": 3, "unknown": 0,
        "conflict": 0, "stale": 1, "notApplicableApproved": 0,
        "blockingReasons": ["RELEASE_STALE"]
      }
    },
    {
      "_case": "PUBLIC_TRACK_REJECT — 全部字段仅有公开轨证据，按 INV-RLS-08 不可发布",
      "releaseId": "RLS-2026.09.04.1",
      "productIds": ["PROD-CM-003"],
      "taxonomyVersion": "CTR-PK-TAX-001@v1",
      "lifecycleState": "DRAFT",
      "purposeFlags": { "interpretationReady": false, "recommendationReady": false },
      "assertionManifestHash": "1111111111111111111111111111111111111111111111111111111111111111",
