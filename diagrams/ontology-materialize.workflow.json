  "cards": [
    {
      "dot": "cyan",
      "title": "对应代码（四份）",
      "items": [
        "ontology_materialize.py:64 · :164 · :200 · :243",
        "ontology_parse.py:103 ; ontology_assets.py:121 ; ontology_reference.py:244"
      ]
    },
    {
      "dot": "rose",
      "title": "fail-closed：六码 + 两异常",
      "items": [
        "_ASSETS_ABSENT / _PROVENANCE_INVALID / _ASSET_DRIFT / _DECLARATION_MISMATCH",
        "LINEAGE_ONTOLOGY_REF_* ; _INSTANCES_NOT_CONFORMING ; SchemaValidationError"
      ]
    },
    {
      "dot": "amber",
      "title": "D-35 空转判据 + 一处放宽",
      "items": [
        "vacuous=true（targetedInstances=0）⇒ conforms=true 不含“已被约束”，不得当证据",
        "声明缺失/非法时跳过钉值与计划血缘比对（信任锚是资产 provenance，不是声明）"
      ]
    }
