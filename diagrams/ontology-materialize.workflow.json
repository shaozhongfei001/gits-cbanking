{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "本体物化环节 · 处理逻辑（校验先于产出）",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "ontology-materialize.html",
    "views": [
      {
        "id": "happy",
        "label": "主路径（校验先于产出）",
        "focus": [
          "entry",
          "load_decl",
          "align",
          "parse",
          "pyshacl",
          "gate_shacl",
          "emit_all"
        ],
        "note": "载入 → 对齐 → 真解析 → 判据 → 落盘；每一步校验都在任何产物写入之前完成。"
      },
      {
        "id": "reject",
        "label": "三面具名拒绝（fail-closed）",
        "focus": [
          "load_decl",
          "rej_assets",
          "align",
          "rej_decl",
          "parse",
          "gate_shacl"
        ],
        "note": "资产漂移 / 钉值与血缘不符 / 判据不成立 —— 一律具名抛出，且一份产物都不写。"
      },
      {
        "id": "d35",
        "label": "判据与空转（D-35）",
        "focus": [
          "parse",
          "pyshacl",
          "gate_shacl",
          "emit_all"
        ],
        "note": "conforms=true 可能不含信息量；靠 targetedInstances / vacuous 判据识破并钉进血缘。"
      }
    ]
  },
  "lanes": [
    {
      "id": "flow",
      "label": "编排与输入 · ontology_materialize.py + ontology_assets.py + ontology_reference.py"
    },
    {
      "id": "parse",
      "label": "解析面 · ontology_parse.py（rdflib + pyshacl）"
    },
    {
      "id": "guard",
      "label": "门禁与具名拒绝（不写任何产物）",
      "variant": "exception"
    },
    {
      "id": "emit",
      "label": "产物 · 04_serve/<service_id>/version=<v>"
    }
  ],
  "phases": [
    {
      "id": "p_intake",
      "label": "载入与对齐",
