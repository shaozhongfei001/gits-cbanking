  "cards": [
    {
      "dot": "cyan",
      "title": "应用层到底在哪（observed）",
      "items": [
        "apps/api＝259 java、30 个 Controller；只有 5 个触发 KERT 技能（左侧 4 条链 + 无 Controller 的装配项）",
        "客户洞察（KycInsightController）与经营旅程（CustomerJourneyController）零引用技能 ⇒ 走本地库（右侧 exception 框）"
      ]
    },
    {
      "dot": "emerald",
      "title": "服务 → 技能 对照（observed）",
      "items": [
        "8 个 SkillExecutionPort 消费者各调一个 skill：报告 / 匹配 / 外联 / 会面 / SP-15 / SP-20 / SP-21 / 图谱",
        "访前包是三技能组合：PrevisitPreparationService → Generator + Outreach + Meeting"
      ]
    },
    {
      "dot": "amber",
      "title": "接缝与兜底（observed）",
      "items": [
        "四列的适配器是同一个 DshHttpSkillExecutionAdapter（重复画以保持每条链完整）：EXECUTE_PATH＝/api/skill/execute",
        "FallbackSkillExecutionAdapter：未配置 KERT 或显式 fallback 时给确定性兜底（deterministic_fallback）"
      ]
    }
  ]
