        "label": "同步主路径",
        "focus": [
          "cm",
          "web",
          "api",
          "adapter",
          "kert",
          "kin"
        ],
        "note": "一次同步调用走完全程；GITS 侧建议读超时 ≥120s。"
      },
      {
        "id": "async",
        "label": "异步与轮询",
        "focus": [
          "adapter",
          "kert",
          "api"
