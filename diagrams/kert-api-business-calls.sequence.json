      {
        "id": "fallback",
        "label": "失败与回落",
        "focus": [
          "adapter",
          "api",
          "kert"
        ],
        "note": "非 200 抛 SkillExecutionException，调用方回落 FallbackSkillExecutionAdapter。"
      }
    ]
